# Pick one provider: gemini, openai, or groq.
AI_PROVIDER=groq

# Change this model name without changing the website.
# Confirm current availability and pricing with your provider before enabling requests.
AI_MODEL=llama-3.3-70b-versatile

# Add a key for the selected provider only. Keep real keys in your local .env file.
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Public website account sign-in. Set the Supabase project URL and its public anon key.
# The service-role key is needed only for private server-side chat storage. Never expose it in the browser.
AUTH_REQUIRED=true
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Safety gate: NOIR will not send prompts to a provider until you explicitly opt in.
# This does not turn on account billing; provider charges depend on your account/model.
ALLOW_BILLABLE_REQUESTS=false

# Optional in-app credits. One credit is charged per successful AI response.
ENABLE_CREDITS=false
STARTING_CREDITS=100
CREDITS_PER_MESSAGE=1

# Optional comma-separated, verified account emails that bypass the credit limit.
# Keep account-specific access settings private in your hosting provider's environment settings.
UNLIMITED_ACCESS_EMAILS=

# MAX_DAILY_TOKENS=0 disables NOIR's daily token quota.
# Limits and local server settings.
MAX_OUTPUT_TOKENS=1024
MAX_DAILY_TOKENS=0
MAX_REQUESTS_PER_MINUTE=12
MAX_PUBLIC_REQUESTS_PER_MINUTE=20
HOST=127.0.0.1
PORT=3000

# Optional: OpenAI reasoning effort (low, medium, high, xhigh, or max; model-dependent).
# Leave blank to use the provider's default.
OPENAI_REASONING_EFFORT=
